pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    some-label: kaniko-debug
spec:
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.9.0-debug
      command:
        - /busybox/sh
      args:
        - -c
        - sleep 3600
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
  volumes:
    - name: docker-config
      secret:
        secretName: docker-config
"""
      defaultContainer 'kaniko'
    }
  }

  stages {
    stage('Debug Info') {
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context=/home/jenkins/agent/workspace/agente-kubernetes/ \
              --dockerfile=/home/jenkins/agent/workspace/agente-kubernetes/Dockerfile \
              --destination=poswark/kaniko-demo:1.0.13 \
              --verbosity=info \
              --skip-tls-verify
          '''
        }
      }
    }

        stage('Scan with Trivy') {
            steps {
                container('tools') {
                    sh '''
                    apk add --no-cache curl
                    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
                    trivy image --insecure ${IMAGE_NAME}:${TAG}
                    '''
                }
            }
        }

        stage('Scan with KICS') {
            steps {
                container('tools') {
                    sh '''
                    apk add --no-cache curl docker
                    curl -sSL https://github.com/Checkmarx/kics/releases/latest/download/kics-linux.tar.gz | tar -xz -C /usr/local/bin
                    kics scan -p /workspace -o /workspace/results --report-formats "json,html"
                    '''
                }
            }
        }

        stage('Publish Results') {
            steps {
                archiveArtifacts artifacts: 'results/*', fingerprint: true
            }
        }
    }
}
