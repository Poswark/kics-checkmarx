pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  annotations:
    sidecar.istio.io/inject: "false"
spec:
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:latest
    command:
    - cat
    tty: true
    volumeMounts:
    - name: kaniko-secret
      mountPath: /kaniko/.docker
    - name: workspace-volume
      mountPath: /workspace
  - name: tools
    image: alpine:3.19
    command:
    - cat
    tty: true
    volumeMounts:
    - name: workspace-volume
      mountPath: /workspace
  volumes:
  - name: kaniko-secret
    secret:
      secretName: docker-config  # ← Aquí montas tu Docker config.json con credenciales
  - name: workspace-volume
    emptyDir: {}
"""
            defaultContainer 'kaniko'
        }
    }

    environment {
        IMAGE_NAME = "poswark/test"
        TAG = "latest"
    }

    stages {
        stage('Build with Kaniko') {
            steps {
                container('kaniko') {
                    sh '''
                    /kaniko/executor \
                      --context=/workspace \
                      --dockerfile=/workspace/Dockerfile \
                      --destination=${IMAGE_NAME}:${TAG} \
                      --skip-tls-verify \
                      --insecure
                    '''
                }
            }
        }

        stage('Scan with Trivy') {
            steps {
                container('tools') {
                    sh '''
                    apk add --no-cache curl
                    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
                    trivy image --insecure ${IMAGE_NAME}:${TAG}
                    '''
                }
            }
        }

        stage('Scan with KICS') {
            steps {
                container('tools') {
                    sh '''
                    apk add --no-cache curl docker
                    curl -sSL https://github.com/Checkmarx/kics/releases/latest/download/kics-linux.tar.gz | tar -xz -C /usr/local/bin
                    kics scan -p /workspace -o /workspace/results --report-formats "json,html"
                    '''
                }
            }
        }

        stage('Publish Results') {
            steps {
                archiveArtifacts artifacts: 'results/*', fingerprint: true
            }
        }
    }
}
